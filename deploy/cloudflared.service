# Cloudflare Tunnel für Antwars. Installation: siehe ANLEITUNG-SERVER.md, Schritt 5.
# Das Tunnel-Token steht NICHT in dieser Datei (Unit-Dateien kann jeder lokale Benutzer lesen),
# sondern in /etc/cloudflared/tunnel.env (Modus 600, Besitzer root, Zeile TUNNEL_TOKEN=...).
# systemd liest diese Datei als root, bevor der Dienst auf den Benutzer 'cloudflared' wechselt.
[Unit]
Description=Cloudflare Tunnel (Antwars)
Documentation=file:///opt/antwars/deploy/ANLEITUNG-SERVER.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=cloudflared
Group=cloudflared
EnvironmentFile=/etc/cloudflared/tunnel.env
# --no-autoupdate: Updates kommen über apt. Der Tunnel baut nur AUSGEHENDE Verbindungen zu Cloudflare auf (Port 7844),
# es wird kein eingehender Port gebraucht. Ziel (Ingress) wird im Cloudflare-Dashboard festgelegt.
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

MemoryMax=256M
TasksMax=128
LimitNOFILE=4096
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# AF_NETLINK: Go-Programme fragen damit die Netzwerkschnittstellen ab. Nicht auf dem Zielsystem getestet.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
SyslogIdentifier=cloudflared

[Install]
WantedBy=multi-user.target
